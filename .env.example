# API Keys (Optional: enhances rate limits for high-throughput searches)
SEMANTIC_SCHOLAR_API_KEY=

# CLI API Proxy Configuration (Default router-for-me/CLIProxyAPI endpoint)
CLI_PROXY_BASE_URL=http://localhost:8317/v1
CLI_PROXY_API_KEY=cli-proxy-token

# Target Models (mapped by your proxy to Gemini, Claude, or Codex)
PLANNER_MODEL=gemini-2.0-flash
WRITER_MODEL=claude-3-5-sonnet
ADVERSARY_MODEL=deepseek-r1
